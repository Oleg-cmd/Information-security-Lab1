{
  "name": "secure-rest-api",
  "version": "1.0.0",
  "description": "Secure REST API with CI/CD security scanning",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "echo 'No build process required for this project'",
    "test": "echo 'No tests configured yet'",
    "security:audit": "npm audit",
    "security:snyk": "snyk test",
    "security:dependency-check": "dependency-check --project secure-rest-api --scan . --format JSON --out dependency-check-report.json"
  },
  "keywords": ["security", "rest-api", "jwt", "express", "nodejs"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "sqlite3": "^5.1.6",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.10.0",
    "validator": "^13.11.0",
    "express-validator": "^7.0.1",
    "xss": "^1.0.15",
    "sequelize": "^6.35.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "hpp": "^0.2.3",
    "express-mongo-sanitize": "^2.2.0",
    "csurf": "^1.11.0",
    "cookie-parser": "^1.4.6"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.2",
    "supertest": "^6.3.3",
    "eslint": "^8.47.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-security": "^1.7.1"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}